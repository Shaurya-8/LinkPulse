// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus{
    PENDING
    ACTIVE
    BLOCKED
    DELETED
}

enum DeviceType {
    DESKTOP
    MOBILE
    TABLET
    UNKNOWN
}

enum AuditAction{
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAIL
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESHED
  TOKEN_REVOKED
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  DEVICE_TRUSTED
  DEVICE_REMOVED
  SESSION_EXPIRED
  RATE_LIMIT_HIT
}

//plan enum
enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum PeriodType{
  NO
  MONTHLY
  YEARLY
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique @db.VarChar(255)
  passwordHash  String      @map("password_hash") @db.Text
  
  firstName     String      @db.VarChar(100) @map("first_name")
  lastName      String?     @db.VarChar(100)  @map("last_name")

  status        UserStatus  @default(PENDING)
  emailVerified Boolean     @default(false) @map("email_verified")
  avatarUrl     String?     @map("avatar_url")

  lastLoginAt   DateTime?   @map("last_login_at") @db.Timestamptz
  loginCount    Int         @default(0) @map("login_count")
  failedLoginCount Int      @default(0) @map("failed_login_count")
  lockedUntil   DateTime?   @map("locked_until") @db.Timestamptz
  
  createdAt     DateTime    @default(now()) @map("created_at")  @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz 

  sessions      Session[]
  devices       UserDevice[]
  auditLogs     AuditLog[]
  passwordResets PasswordResetToken[]
  subscriptions Subscriptions[] 
  links         Link[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([lastLoginAt])

  @@map("users") 
}

model Session {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  deviceId      String?     @map("device_id") @db.Uuid

  refreshToken  String      @unique @map("refresh_token") @db.Char(64)
  accessJti     String      @unique @map("access_jti") @db.Uuid

  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.VarChar(512)
  country       String?     @db.VarChar(2)
  city          String?     @db.VarChar(100)

  isActive      Boolean     @default(true) @map("is_active")
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz
  lastUsedAt    DateTime    @default(now()) @map("last_used_at") @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz 
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz   
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        UserDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  
  @@index([userId, isActive])
  @@index([accessJti])
  @@index([expiresAt])
  @@index([lastUsedAt])

  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)  // SHA-256
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at")    @db.Timestamptz
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])

  @@map("password_reset_tokens")
}


model UserDevice {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid

  deviceFingerprint String  @unique @map("device_fingerprint") @db.Char(64)
  ipAddress     String?

  deviceName    String?     @map("device_name") @db.VarChar(200)
  deviceType    DeviceType  @default(UNKNOWN)  @map("device_type")
  os            String?     @db.VarChar(100)  
  osVersion     String?     @map("os_version") @db.VarChar(50)
  browser       String?     @db.VarChar(100)
  browserVersion String?    @map("browser_version") @db.VarChar(20)
  cpu           String?     @db.VarChar(50)

  isTrusted     Boolean     @default(false) @map("is_trusted")
  isPushEnabled Boolean     @default(false) @map("is_push_enabled")
  pushToken     String?     @map("push_token") @db.VarChar(512)

  loginCount    Int         @default(1) @map("login_count")

  firstSeenAt   DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt    DateTime    @default(now()) @map("last_seen_at")  @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sessions      Session[]
  like          Link[]
  @@unique([userId, deviceFingerprint])

  @@map("user_devices")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  action        AuditAction 
  sessionId     String?     @map("session_id") @db.Uuid
  ipAddress     String?     @map("ip_address") @db.VarChar(45)       
  userAgent     String?     @map("user_agent") @db.VarChar(512)
  country       String?     @db.VarChar(2)
  metadata      Json?       @db.JsonB
  success       Boolean     @default(true)
  errorCode     String?     @map("error_code") @db.VarChar(100)
  errorMsg      String?     @map("error_msg")  @db.VarChar(512)
  durationMs    Int?        @map("duration_ms")  // request processing time in ms
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId,    createdAt(sort: Desc)])
  @@index([action,    createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([sessionId])

  @@map("audit_logs")
}

model Link {
  id            String    @id @default(uuid()) @db.Uuid
  shortCode     String    @unique @map("short_code")
  customAlias   String?   @unique @map("custom_alias")
  longUrl       String    @map("long_url")
  normalizedUrl String    @map("normalized_url")
  
  isOneTime     Boolean   @default(false) @map("is_one_time")

  title         String?   @db.VarChar(256)
  description   String?   @db.VarChar(512)
  faviconUrl    String?
  
  isActive      Boolean   @default(true) @map("is_active")
  
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  passwordHash  String?   @map("password_hash")    
  totalClicks   Int       @default(0)@map("total_clicks")
  clickLimit    Int       @default(0) @map("click_limit")
  userId        String?   @map("user_id") @db.Uuid
  deviceId      String

  user          User?     @relation (fields: [userId], references: [id], onDelete: SetNull)  

  device        UserDevice @relation (fields: [deviceId], references: [id], onDelete: Cascade)
  clicks        LinkClick[]

  @@index([expiresAt, isActive])
  @@index([expiresAt])
  @@index([userId])
  @@index([createdAt])

  @@map("links")
}

model LinkClick {
  id          String      @id @default(uuid()) @db.Uuid
  linkId      String      @map("link_id") @db.Uuid
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(512)
  referer     String?
  country     String?     @db.VarChar(2)
  city        String?
  deviceType  DeviceType  @default(UNKNOWN) @map("device_type")
  browser     String?     @db.VarChar(100)
  os          String?     @db.VarChar(100)
  clickedAt   DateTime    @default(now())
  isBot       Boolean     @default(false)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  
  @@index([clickedAt])
  @@index([linkId, clickedAt(sort: Desc)])

  @@map("link_clicks")
}

model Plans {
  id            string        @id @default(uuid()) @db.Uuid
  name          PlanType      @default(FREE)
  price         Int           @default(0)

  featuresLimit      FeaturesLimit[]
  subscriptions      Subscriptions[]

  @@map(plans)
}

model Features {
  id            String        @id @default(uuid()) @db.Uuid
  key           String        
  name          String 

  featuresLimit FeaturesLimit[]
  @@map(features)       
}

model FeaturesLimit {
  id            String        @id @default(uuid()) @db.Uuid
  featureId     String        @map(feature_id)
  planId        String        @map(plan_id)
  value         Int            //-1 = unlimited

  features      Features      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plans         Plans         @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map(feature_limit)
}

enum SubscriptionStatus{
  ACTIVE
  INACTIVE
}

enum BillingPeriod{
  MONTHLY 
  YEARLY
}

model Subscriptions {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map(user_id) @map(user_id)
  planId      String        @map(plan_id) @map(Plan_id)
  status      Subscriptions @default(INACTIVE)        
  startedAt   DateTime      @default(now()) @map(started_at)
  expriresAt  DateTime      @map(expires_at)
  billingPeriod  String        @default(MONTHLY) @map(billing_period)

  plan        String        @relation(fields:[planId], references: [id], onDelete: Cascade)
  user        String        @relation(fields:[userId], references: [id], onDelete: Cascade)
  @@map(subscriptions)
}